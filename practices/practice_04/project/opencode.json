{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "project-dev",
  "instructions": [
    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "plugin": [
    "./.opencode/plugins/auto-check.js"
  ],
  "mcp": {
    "task-cli": {
      "type": "local",
      "command": ["python3", "mcp/task_cli_mcp.py"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "scripts/check.sh*": "allow",
      "pytest*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "read": "allow",
    "external_directory": {
      "../**": "deny",
      "../../**": "deny",
      "*": "deny"
    }
  },
  "tool_output": { "max_lines": 200, "max_bytes": 8192 },
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  }
}
